# Copy this file to .env in backend/ and frontend/ as needed.

# --- Backend (Java / Spring Boot) ---
# Supabase Project Settings → Database → Connection string (URI)
# Convert postgres:// to jdbc:postgresql:// and add sslmode=require
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password
SERVER_PORT=8080

# --- Frontend (React) ---
# Leave this pointing at the Java API, not directly at Supabase
VITE_API_BASE_URL=http://localhost:8080
